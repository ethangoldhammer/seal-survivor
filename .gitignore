node_modules
dist
# Look-page builds (npm run looks:cash, and the yacht deck's equivalent). A
# vite build of tools/looks/*.html plus the PNGs the page POSTs back to
# tools/looks/serve.mjs — generated, and only useful for the hour you look at
# them. The PAGES are tracked; their output is not.
dist-cash-look
dist-yacht-look

# The layout audit's build and its report (npm run layout). Same deal as the
# look pages: the page and the runner are tracked, what they generate is not.
dist-layout-audit
.DS_Store
.env
server/.wrangler

# Recorded playtest runs — session data, not source. `npm run playtest`
# reads this; delete it any time to start a fresh body of evidence.
playtest/

# The rendered sound atlas — a megabyte of it is base64'd audio, regenerated
# by `npm run sfx:atlas`. The data file it is built from (tools/sfx-atlas.json)
# IS tracked, because a diff of that is how you see what a change did to the
# sound bank.
tools/sfx-atlas.html

# The grid shader compile check, written by tools/grid-shader-check.mjs and
# opened in a browser. Generated, and only useful for the minute you look at it.
.grid-shader-check.html
.water-shader-check.html
.impact-shader-check.html
.biolum-shader-check.html

# WebGL renders for the Model Atlas — regenerated by tools/atlas-render, never committed
tools/atlas-render/shots/
