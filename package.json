{
  "name": "seal-survivor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=seal-survivor --branch=SealSurvivor-Main",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name=seal-survivor --branch=preview",
    "placeholder": "node tools/make-placeholder-ship.mjs",
    "playtest": "node tools/playtest-report.mjs",
    "test:crowd": "node tools/apex-crowd-test.mjs",
    "test:upgrades": "node --import ./tools/vite-loader.mjs tools/upgrade-test.mjs",
    "test:abilities": "node --import ./tools/vite-loader.mjs tools/ability-smoke.mjs",
    "test:octopus": "node --import ./tools/vite-loader.mjs tools/octopus-rig-test.mjs",
    "test:biolum": "node --import ./tools/vite-loader.mjs tools/biolum-test.mjs",
    "test:skin": "node --import ./tools/vite-loader.mjs tools/biolum-skin-test.mjs",
    "test:boats": "node --import ./tools/vite-loader.mjs tools/boat-destruction-test.mjs",
    "test:grass": "node --import ./tools/vite-loader.mjs tools/grass-sway-test.mjs",
    "test:crabs": "node --import ./tools/vite-loader.mjs tools/crab-crowd-test.mjs",
    "test:strike": "node --import ./tools/vite-loader.mjs tools/strike-direction-test.mjs",
    "test:spriteglow": "node --import ./tools/vite-loader.mjs tools/sprite-glow-test.mjs",
    "test:rig": "node --import ./tools/vite-loader.mjs tools/seal-rig-test.mjs",
    "test:apexspring": "node --import ./tools/vite-loader.mjs tools/apex-spring-test.mjs",
    "test:nightlife": "node --import ./tools/vite-loader.mjs tools/nightlife-test.mjs",
    "ship": "node tools/ship.mjs",
    "test": "npm run test:upgrades && npm run test:abilities && npm run test:crowd && npm run test:octopus && npm run test:biolum && npm run test:skin && npm run test:boats && npm run test:grass && npm run test:crabs && npm run test:strike && npm run test:rig && npm run test:apexspring && npm run test:nightlife && npm run test:ambient && npm run test:emissive && npm run test:bus && npm run test:sfxdebug && npm run test:menusound && npm run test:music && npm run test:chargefx && npm run test:damagefx && npm run test:quips && npm run test:particles && npm run test:touchglow && npm run test:spriteglow",
    "test:ambient": "node --import ./tools/vite-loader.mjs tools/ambient-test.mjs",
    "test:emissive": "node --import ./tools/vite-loader.mjs tools/emissive-flip-test.mjs",
    "sfx:atlas": "node --import ./tools/vite-loader.mjs tools/sfx-atlas.mjs",
    "test:bus": "node --import ./tools/vite-loader.mjs tools/sfx-bus-test.mjs",
    "test:sfxdebug": "node --import ./tools/vite-loader.mjs tools/sfx-debug-test.mjs",
    "test:menusound": "node tools/menu-sound-test.mjs",
    "test:quips": "node tools/quip-test.mjs",
    "test:music": "node --import ./tools/vite-loader.mjs tools/music-loop-test.mjs",
    "test:chargefx": "node --import ./tools/vite-loader.mjs tools/charge-fx-test.mjs",
    "test:damagefx": "node --import ./tools/vite-loader.mjs tools/damage-fx-test.mjs",
    "test:particles": "node --import ./tools/vite-loader.mjs tools/particle-test.mjs",
    "test:touchglow": "node --import ./tools/vite-loader.mjs tools/touch-glow-test.mjs"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.39.2",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vite": "^6.0.0",
    "wrangler": "^4.120.0"
  }
}
