# The deployed leaderboard worker (server/leaderboard-worker.js).
#
# This lives in .env.production, NOT .env, on purpose: Vite loads .env in every
# mode, so putting the URL there would point `npm run dev` at the live board and
# file every local playtest run onto the public list. `.env.production` is read
# only by `vite build`, which keeps dev scores local to the browser — the
# behaviour server/README.md describes — while the shipped build talks to the
# worker.
#
# Inlined at BUILD time. Changing it means rebuilding; an existing dist/ will go
# on using whatever URL it was built with.
VITE_LEADERBOARD_URL=https://seal-survivor-leaderboard.ethan-goldhammer.workers.dev

# The deployed playtest collection worker (server/playtest/playtest-worker.js).
#
# Here rather than in .env for the same reason as the board above, and one more:
# systems/playtest.js sends a finished run to the dev server's /__playtest when
# import.meta.env.DEV is set and to this URL otherwise, never both. A dev run is
# played against half-finished tuning, so keeping it out of the shared
# collection is what stops the aggregate from mixing two different games —
# .env.production is read only by `vite build`, which draws that line exactly.
#
# COMMITTED, unlike a secret. This is a write-only ingest endpoint: anyone can
# post a run to it, which is already true of anyone who opens devtools on the
# live site. Reading the collection back needs PULL_TOKEN, which is a Cloudflare
# secret and is not in this repo.
VITE_PLAYTEST_URL=https://seal-survivor-playtest.ethan-goldhammer.workers.dev

# The deployed room worker (server/room/room-worker.js) — Blubberball's online
# rooms, where two people on two machines meet at a five-letter code.
#
# .env.production and not .env, and here the reason is stronger than it is for
# the two above: `roomsAvailable()` is read by ui.js to decide whether to DRAW
# the online row at all, so setting this in .env would put a live-server button
# on every `npm run dev` session. A local room server belongs in .env.local,
# which Vite loads in dev and never in a build.
#
# Inlined at BUILD time, like the others. A dist/ built before this line existed
# has online play compiled out of it entirely — not merely misconfigured — so
# changing this means a rebuild, not a redeploy of the same bundle.
#
# COMMITTED. There is no secret here: a room code is the only credential, it is
# five characters, and it authorises exactly one seat in one match.
VITE_ROOM_URL=https://seal-survivor-room.ethan-goldhammer.workers.dev
