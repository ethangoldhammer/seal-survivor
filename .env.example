# Copy to `.env` and fill in the Worker URL printed by `wrangler deploy`
# (see server/README.md). Vite inlines this at BUILD time, so a deployed build
# has to be rebuilt after changing it — it is not read at runtime.
#
# Leave it unset and the leaderboard stays local to each browser, which is what
# you want for `npm run dev`.
VITE_LEADERBOARD_URL=https://seal-survivor-leaderboard.YOUR-SUBDOMAIN.workers.dev

# ---------------------------------------------------------------------------
# Playtest collection (see server/playtest/README.md)
#
# Where a DEPLOYED build files its run records. Same rule as above: inlined at
# build time, so changing it means rebuilding. Leave it unset and runs stay in
# each player's browser exactly as they did before the collection existed.
#
# `npm run dev` ignores this entirely — a dev run goes straight to
# playtest/runs.jsonl on disk and is deliberately never posted to the
# collection, so runs played against half-saved tuning can't contaminate it.
VITE_PLAYTEST_URL=https://seal-survivor-playtest.YOUR-SUBDOMAIN.workers.dev

# The secret that lets `npm run playtest:pull` READ the collection back. Must
# match what you gave `npx wrangler secret put PULL_TOKEN` in server/playtest/.
# Anyone holding this can download every collected run, so it belongs in .env
# (gitignored) and nowhere else — in particular NOT in a VITE_ variable, which
# would inline it into the public bundle for every player to read.
PLAYTEST_TOKEN=


# ---------------------------------------------------------------------------
# iOS deploy (npm run ship:ios / npm run ship:all — see tools/ship-ios.mjs)
#
# An App Store Connect API key, created at App Store Connect > Users and Access
# > Integrations > App Store Connect API as a TEAM key with the App Manager
# role. The .p8 downloads exactly once; put it in
# ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 and it is found
# automatically (ASC_KEY_PATH overrides that if it lives somewhere else).
#
# These are credentials for the whole developer account — signing certificates,
# TestFlight, releases — so they belong in .env (gitignored) and never in a
# VITE_ variable, which would inline them into the public bundle.
ASC_KEY_ID=
ASC_ISSUER_ID=
# ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
