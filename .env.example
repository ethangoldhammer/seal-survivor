# Copy to `.env` and fill in the Worker URL printed by `wrangler deploy`
# (see server/README.md). Vite inlines this at BUILD time, so a deployed build
# has to be rebuilt after changing it — it is not read at runtime.
#
# Leave it unset and the leaderboard stays local to each browser, which is what
# you want for `npm run dev`.
VITE_LEADERBOARD_URL=https://seal-survivor-leaderboard.YOUR-SUBDOMAIN.workers.dev
