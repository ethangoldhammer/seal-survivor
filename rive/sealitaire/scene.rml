                    <Ellipse width="7" height="7" originX="0.5" originY="0.5" name="P" id="0:194"/>
                    <Fill name="F" id="0:195"><SolidColor colorValue="FFF7F1E6" name="C" id="0:196"/></Fill>
                </Shape>
                <Shape name="Body" id="0:197">
                    <Ellipse width="26" height="26" originX="0.5" originY="0.5" name="P" id="0:198"/>
                    <Fill name="F" id="0:199"><SolidColor colorValue="FF1E2A44" name="C" id="0:1100"/></Fill>
                </Shape>
            </Node>
        </Node>

        <Node name="Shell" id="0:1101">
            <DataBindContext sourcePathIds="0:320-0:326" propertyKey="18" id="0:1102"/>
            <Node x="60" y="86" scaleX="1.6" scaleY="1.6" name="Big" id="0:1103">
                <Shape name="Body" id="0:1104">
                    <Star y="-2" width="30" height="26" points="8" innerRadius="0.78" cornerRadius="1" originX="0.5" originY="0.5" name="P" id="0:1105"/>
                    <Triangle y="13" rotation="3.1415927" width="12" height="9" originX="0.5" originY="0.5" name="Hinge" id="0:1106"/>
                    <Fill name="F" id="0:1107"><SolidColor colorValue="FF1E2A44" name="C" id="0:1108"/></Fill>
                </Shape>
            </Node>
            <Node x="20" y="44" scaleX="0.6" scaleY="0.6" name="Small TL" id="0:1109">
                <Shape name="Body" id="0:1110">
                    <Star y="-2" width="30" height="26" points="8" innerRadius="0.78" cornerRadius="1" originX="0.5" originY="0.5" name="P" id="0:1111"/>
                    <Triangle y="13" rotation="3.1415927" width="12" height="9" originX="0.5" originY="0.5" name="Hinge" id="0:1112"/>
                    <Fill name="F" id="0:1113"><SolidColor colorValue="FF1E2A44" name="C" id="0:1114"/></Fill>
                </Shape>
            </Node>
            <Node x="100" y="124" rotation="3.1415927" scaleX="0.6" scaleY="0.6" name="Small BR" id="0:1115">
                <Shape name="Body" id="0:1116">
                    <Star y="-2" width="30" height="26" points="8" innerRadius="0.78" cornerRadius="1" originX="0.5" originY="0.5" name="P" id="0:1117"/>
                    <Triangle y="13" rotation="3.1415927" width="12" height="9" originX="0.5" originY="0.5" name="Hinge" id="0:1118"/>
                    <Fill name="F" id="0:1119"><SolidColor colorValue="FF1E2A44" name="C" id="0:1120"/></Fill>
                </Shape>
            </Node>
        </Node>

        <!-- The plate: cream face with a faint inner border. -->
        <Shape x="60" y="84" name="Inner Border" id="0:1121">
            <Rectangle width="108" height="156" originX="0.5" originY="0.5" cornerRadiusTL="7" name="P" id="0:1122"/>
            <Stroke thickness="1.5" name="Edge" id="0:1123"><SolidColor colorValue="26000000" name="C" id="0:1124"/></Stroke>
        </Shape>
        <Shape x="60" y="84" name="Plate" id="0:1125">
            <Rectangle width="120" height="168" originX="0.5" originY="0.5" cornerRadiusTL="10" name="P" id="0:1126"/>
            <Fill name="Fill" id="0:1127">
                <LinearGradient startX="-60" startY="-84" endX="60" endY="84" name="G" id="0:1128">
                    <GradientStop colorValue="FFFFFBF3" position="0" id="0:1129"/>
                    <GradientStop colorValue="FFF1E8D6" position="1" id="0:1130"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <StateMachine name="State Machine 1" id="0:102">
