            <Stroke thickness="0.5" name="S" id="0:228"><SolidColor colorValue="FF7FB6E8" name="C" id="0:229"/></Stroke>
        </Shape>
        <Shape x="60" y="84" name="Plate" locked="true" id="0:230">
            <Rectangle width="120" height="168" originX="0.5" originY="0.5" cornerRadiusTL="10" name="P" id="0:231"/>
            <Fill name="Fill" id="0:232">
                <LinearGradient startX="0" startY="66.612" endX="0" endY="-78.859" name="G" id="0:233">
                    <GradientStop colorValue="FF032744" position="0" id="0:234"/>
                    <GradientStop colorValue="FF0966B9" position="1" id="0:235"/>
