<Rive version="1" kind="fragment">

    <!-- =========================================================================
         SEALITAIRE — Klondike, played on the ocean, native to Rive.

         The artboards:
           Sealitaire   the screen: one ScriptedLayout (table.luau) filling the
                        artboard. It draws the vortex (GPU canvas), the cards
                        (the two card artboards below, instanced 52 times), the
                        seal (a skinned mesh in a second GPU canvas), the HUD,
                        and the CRT pass that composites all of it.
           Title HUD    the chrome: Title, Stats, Status and Deal, one small
           Stats        artboard per corner of the screen, bound to the Table
           Status       view model. Text is markup-only, so the words live
           Deal         here and the script places each block from layout.luau.
           (cards.rml)  Card A … Card K, one artboard per rank, built from the
                        Pip / Corner / Plate components. The script instances
                        the rank's artboard per card with a Card view model.
           Card Back    the back. No data; a state machine so it advances.

         Copy rule: every player-facing label here is a [DRAFT] shape or lorem.
         Card ranks (A 2 .. K) are symbols, not prose.

         Hierarchy order: FIRST child draws on TOP.
         ========================================================================= -->

    <Artboard defaultStateMachineId="0:4" viewModelId="0:300" viewModelInstanceId="0:310"
              clip="true" x="0" y="0" width="1600" height="1000" styleId="0:3"
              name="Sealitaire" id="0:2">
        <Fill name="Background" id="0:6">
            <SolidColor colorValue="FF07182B" name="Color" id="0:7"/>
        </Fill>
        <LayoutComponentStyle name="Artboard Style" id="0:3"/>

        <!-- The table: one script, the whole artboard. Fill-sized so `resize`
             receives the artboard and pointer positions are artboard units. -->
        <LayoutComponent width="1600" height="1000" styleId="0:11" name="Root" id="0:10">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="Root Style" id="0:11"/>
            <ScriptedLayout scriptAssetId="0:401" name="Table" id="0:12">
                <ScriptInputArtboard artboardId="2:1000" name="faceA" id="0:600"/>
                <ScriptInputArtboard artboardId="2:1010" name="face2" id="0:601"/>
                <ScriptInputArtboard artboardId="2:1020" name="face3" id="0:602"/>
                <ScriptInputArtboard artboardId="2:1030" name="face4" id="0:603"/>
                <ScriptInputArtboard artboardId="2:1040" name="face5" id="0:604"/>
                <ScriptInputArtboard artboardId="2:1050" name="face6" id="0:605"/>
                <ScriptInputArtboard artboardId="2:1060" name="face7" id="0:606"/>
                <ScriptInputArtboard artboardId="2:1070" name="face8" id="0:607"/>
                <ScriptInputArtboard artboardId="2:1080" name="face9" id="0:608"/>
                <ScriptInputArtboard artboardId="2:1090" name="face10" id="0:609"/>
                <ScriptInputArtboard artboardId="2:1100" name="faceJ" id="0:610"/>
                <ScriptInputArtboard artboardId="2:1110" name="faceQ" id="0:611"/>
                <ScriptInputArtboard artboardId="2:1120" name="faceK" id="0:612"/>
                <ScriptInputArtboard artboardId="0:200" name="back" id="0:14"/>
                <ScriptInputArtboard artboardId="0:500" name="hudTitle" id="0:17"/>
                <ScriptInputArtboard artboardId="0:520" name="hudStats" id="0:620"/>
                <ScriptInputArtboard artboardId="0:560" name="hudDeal" id="0:622"/>
                <ScriptInputArtboard artboardId="1:7000" name="tunerRow" id="0:18"/>
                <ScriptInputArtboard artboardId="1:7100" name="tunerHead" id="0:19"/>
                <FocusData id="0:15"/>
            </ScriptedLayout>
        </LayoutComponent>

        <StateMachine name="State Machine 1" id="0:4">
            <StateMachineLayer name="Layer 1" id="0:5">
                <AnyState x="300" y="0" id="0:8"/>
                <ExitState x="400" y="0" id="0:9"/>
                <EntryState x="0" y="0" id="0:16"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>


    <!-- =========================================================================
