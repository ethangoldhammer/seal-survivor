    <ComponentAsset artboardId="0:200" name="Card Back" id="0:291"/>


    <!-- =========================================================================
         DATA
         ========================================================================= -->

    <!-- The screen. Every value is a string the script has already formatted:
         Rive cannot format, and a number bound to a text run needs a converter. -->
    <ViewModel defaultInstanceId="0:310" name="Table" id="0:300">
        <ViewModelPropertyString name="moves" id="0:301"/>
        <ViewModelPropertyString name="score" id="0:302"/>
        <ViewModelPropertyString name="clock" id="0:303"/>
        <!-- The lab: `rive ... --data=lab=<species>` puts one species on every
             card for tools/sealitaire-sheet.mjs. Blank in play. -->
        <ViewModelPropertyString name="lab" id="0:305"/>
        <!-- RE-DEAL, FROM OUTSIDE THE TABLE. A counter, not a flag: the pause
             menu in the game (path/src/ui/pauseMenu.js) bumps it, and the
             script deals when the number it reads stops matching the one it
             last saw. A boolean would need somebody to set it back, and the
             only two candidates for that are the script clearing a property it
             does not own or the shell clearing it on a frame the table may not
             have advanced through yet. Nothing sets this in the CLI, where N
             and the Re-Deal button are the whole of it. -->
        <ViewModelPropertyNumber name="deal" id="0:306"/>
        <ViewModelInstance exports="true" name="Instance" id="0:310">
            <ViewModelInstanceString propertyValue="0" viewModelPropertyId="0:301" id="0:311"/>
            <ViewModelInstanceString propertyValue="0" viewModelPropertyId="0:302" id="0:312"/>
            <ViewModelInstanceString propertyValue="0:00" viewModelPropertyId="0:303" id="0:313"/>
            <ViewModelInstanceString propertyValue="" viewModelPropertyId="0:305" id="0:315"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:306" id="0:316"/>
        </ViewModelInstance>
    </ViewModel>

    <!-- One card. The script makes 52 instances of this. -->
    <ViewModel defaultInstanceId="0:330" name="Card" id="0:320">
        <ViewModelPropertyString name="rank" id="0:321"/>
        <ViewModelPropertyColor name="ink" id="0:322"/>
        <ViewModelPropertyNumber name="fish" id="0:323"/>
        <ViewModelPropertyNumber name="star" id="0:324"/>
        <ViewModelPropertyNumber name="bubble" id="0:325"/>
        <ViewModelPropertyNumber name="shell" id="0:326"/>
        <ViewModelPropertyNumber name="plate" id="0:327"/>
        <ViewModelPropertyNumber name="red" id="0:328"/>
        <ViewModelPropertyNumber name="black" id="0:329"/>
        <ViewModelPropertyNumber name="pulse" id="0:340"/>
        <ViewModelPropertyNumber name="numTrimOffset" id="0:342"/>
        <!-- The corner's drop shadow, one setting for the rank and all four
             suits: `shadowSoft` is the Feather strength, `shadowX`/`shadowY`
             its offset (world space, so the rank at 0.4 and the suit at 0.8
             cast the same shadow). Edit the default instance and every card
             in the editor follows. Editor-only for now — a Feather inside a
             Fill renders nothing at runtime (rive docs drawing). -->
        <ViewModelPropertyNumber name="shadowSoft" id="0:344"/>
        <ViewModelPropertyNumber name="shadowX" id="0:345"/>
        <ViewModelPropertyNumber name="shadowY" id="0:346"/>
        <ViewModelInstance exports="true" name="Instance" id="0:330">
            <ViewModelInstanceString propertyValue="A" viewModelPropertyId="0:321" id="0:331"/>
            <ViewModelInstanceColor propertyValue="FFD0392B" viewModelPropertyId="0:322" id="0:332"/>
            <ViewModelInstanceNumber propertyValue="1" viewModelPropertyId="0:323" id="0:333"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:324" id="0:334"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:325" id="0:335"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:326" id="0:336"/>
            <ViewModelInstanceNumber propertyValue="1" viewModelPropertyId="0:327" id="0:337"/>
            <ViewModelInstanceNumber propertyValue="1" viewModelPropertyId="0:328" id="0:338"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:329" id="0:339"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:340" id="0:341"/>
            <ViewModelInstanceNumber propertyValue="0.2" viewModelPropertyId="0:342" id="0:343"/>
            <ViewModelInstanceNumber propertyValue="8" viewModelPropertyId="0:344" id="0:347"/>
            <ViewModelInstanceNumber propertyValue="1" viewModelPropertyId="0:345" id="0:348"/>
            <ViewModelInstanceNumber propertyValue="1" viewModelPropertyId="0:346" id="0:349"/>
        </ViewModelInstance>
    </ViewModel>


    <!-- =========================================================================
         ASSETS. Modules must be declared before the script that requires them.
         Shaders (.wgsl) and the seal.mesh blob need no markup: the build scans
         the directory and the script fetches them by name.
         ========================================================================= -->
    <FontAsset file="fonts/Inter.ttf" name="Inter" id="0:400"/>
    <!-- Ethan's picks from the editor (2026-09-19): the title and readouts in
         Abril Fatface, the ranks in Brygada 1918, and a photo behind the back. -->
    <FontAsset file="fonts/Brygada 1918.ttf" name="Brygada 1918" id="0:1108"/>
    <FontAsset file="fonts/Abril Fatface.ttf" name="Abril Fatface" id="0:1109"/>
    <!-- Ethan picked this in the EDITOR, for the deal button. It keeps the id
         the editor gave it (1:9409, the editor's own namespace rather than
         this file's 0:*) so that a pull sees the two sides agreeing instead
         of reporting the reference as changed every time. The pull brought
         the reference down without the font — `rive pull` has both now. -->
    <FontAsset file="fonts/Anton SC.ttf" name="Anton SC" id="1:9409"/>
    <BlobAsset file="seal.mesh" name="seal" id="0:404"/>
    <BlobAsset file="fish.mesh" name="fish" id="0:420"/>
    <BlobAsset file="tanks.csv" name="tanks" id="0:613"/>
    <BlobAsset file="sfxEvents.csv" name="sfxEvents" id="0:616"/>
    <!-- The bank INDEX, so J/K/L can walk the sounds that are actually in the
         file. Ids used to be generated from a position (hg-cards-%03d), which
