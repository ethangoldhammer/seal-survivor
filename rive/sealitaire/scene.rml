    </Artboard>


    <!-- =========================================================================
         THE CHROME — four small artboards, one per corner of the screen, each
         instanced and placed by table.luau from `layout.luau`'s anchors.

         It used to be ONE artboard the size of the table, with every label
         hand-placed in 1600x1000 space and drawn at (0,0). That is exactly as
         responsive as a printed page: on a phone the deal button sat 1480px
         to the right of a 390px screen, and the status line 956px down an
         844px one — both simply gone. Text is markup-only, so the fix cannot
         be "let the script place the words"; it is to cut the page into the
         pieces that each belong to an edge, and let the script place THOSE.

         So the split is by ANCHOR, not by tidiness: title and stats to the
         top left, the deal button to the top right, the status line to the
         bottom left. Each one's content starts at its own (0,0) and the
         script translates and scales it as a block, which is why every
         position inside these artboards is relative and none of them mentions
         the size of the screen.

         All four carry the Table view model so the script can instance them
         the same way; two of them have nothing bound and lose nothing by it.
         Labels are staged as [DRAFT] shapes.
         ========================================================================= -->
    <Artboard isComponent="true" defaultStateMachineId="0:504" viewModelId="0:300" viewModelInstanceId="0:310"
              x="0" y="1100" width="260" height="56" styleId="0:501" name="Title" id="0:500">
        <LayoutComponentStyle name="Style" id="0:501"/>
        <Text x="0" y="0" sizingValue="autoWidth" name="Title" id="0:20">
            <TextStylePaint fontSize="40" letterSpacing="-0.02" fontAssetId="0:1109" familyName="Abril Fatface" styleName="Regular" name="S" id="0:21">
                <Stroke thickness="3" name="Glow" id="0:1084"><SolidColor colorValue="FFF6F1E7" name="C" id="0:1085"/><Feather strength="12" name="F" id="0:1086"/></Stroke><Fill name="Fill" id="0:22"><SolidColor colorValue="FFF6F1E7" name="C" id="0:23"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="0:21" text="Sealitaire" name="Run" id="0:24"/>
            <!-- Ethan's shimmer: a dim band swept across the title by Timeline 1. -->
            <TextModifierGroup modifyOpacity="true" invertOpacity="true" opacity="0.15" name="Modifier Group 1" id="0:1111">
                <TextModifierRange modifyFrom="0.53" modifyTo="0.88" modeValue="5" falloffFrom="0.68" falloffTo="0.75" offset="-0.97" name="Range 1" id="0:1112"/>
            </TextModifierGroup>
        </Text>
        <LinearAnimation fps="24" duration="24" speed="0.3" loopValue="1" workStart="0" workEnd="1" quantize="true" name="Timeline 1" id="0:1113">
            <KeyedObject objectId="0:1112" id="0:1114">
                <KeyedProperty propertyKey="319" id="0:1115">
                    <KeyFrameDouble value="-0.97" interpolationType="1" id="0:1116"/>
                    <KeyFrameDouble value="0.59" interpolationType="1" frame="24" id="0:1117"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <StateMachine name="State Machine 1" id="0:504">
            <StateMachineLayer name="Layer 1" id="0:505">
                <AnyState x="300" y="0" id="0:506"/>
                <ExitState x="400" y="0" id="0:507"/>
                <EntryState x="-41" y="6" id="0:508">
                    <StateTransition stateToId="0:1118" id="0:1119"/>
                </EntryState>
                <AnimationState animationId="0:1113" x="97" y="13" id="0:1118"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

