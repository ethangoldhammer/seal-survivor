    <!-- =========================================================================
         CARD BACK — navy, with bubbles rising. No data.
         ========================================================================= -->
    <Artboard isComponent="true" x="1900" y="0" width="120" height="168" styleId="0:201" name="Card Back" id="0:200">
        <LayoutComponentStyle name="Style" id="0:201"/>
        <Shape x="38" y="118" name="Bubble 1" id="0:210">
            <Ellipse width="30" height="30" originX="0.5" originY="0.5" name="P" id="0:211"/>
