    <ComponentAsset artboardId="0:100" name="Card Face" id="0:290"/>
    <ComponentAsset artboardId="0:200" name="Card Back" id="0:291"/>


    <!-- =========================================================================
         DATA
         ========================================================================= -->

    <!-- The screen. Every value is a string the script has already formatted:
         Rive cannot format, and a number bound to a text run needs a converter. -->
    <ViewModel defaultInstanceId="0:310" name="Table" id="0:300">
        <ViewModelPropertyString name="moves" id="0:301"/>
        <ViewModelPropertyString name="score" id="0:302"/>
        <ViewModelPropertyString name="clock" id="0:303"/>
        <ViewModelPropertyString name="status" id="0:304"/>
        <ViewModelInstance exports="true" name="Instance" id="0:310">
            <ViewModelInstanceString propertyValue="0" viewModelPropertyId="0:301" id="0:311"/>
            <ViewModelInstanceString propertyValue="0" viewModelPropertyId="0:302" id="0:312"/>
            <ViewModelInstanceString propertyValue="0:00" viewModelPropertyId="0:303" id="0:313"/>
            <ViewModelInstanceString propertyValue="Lorem ipsum dolor sit amet" viewModelPropertyId="0:304" id="0:314"/>
        </ViewModelInstance>
    </ViewModel>

    <!-- One card. The script makes 52 instances of this. -->
    <ViewModel defaultInstanceId="0:330" name="Card" id="0:320">
        <ViewModelPropertyString name="rank" id="0:321"/>
        <ViewModelPropertyColor name="ink" id="0:322"/>
        <ViewModelPropertyNumber name="fish" id="0:323"/>
        <ViewModelPropertyNumber name="star" id="0:324"/>
