<Rive version="1" kind="fragment">
    <!-- =========================================================================
         THE TUNER'S PARTS. Two small component artboards the script instances
         and lays out itself (table.luau, "The tuner panel"): one TunerRow per
         line of tuning.luau, one TunerHead per category (and two more for
         SAVE / RESET). Nothing here knows how many rows there are, so a new
         tunable is one line in tuning.luau and nothing to regenerate.
         Labels are keys and tooling words, not a player's copy.
         ========================================================================= -->

    <Artboard isComponent="true" defaultStateMachineId="1:9000" viewModelId="1:8000" viewModelInstanceId="1:8001"
              x="1700" y="1100" width="380" height="16" styleId="1:1" name="TunerRow" id="1:7000">
        <LayoutComponentStyle name="Style" id="1:1"/>
        <Text x="16" y="1" sizingValue="autoWidth" name="Label" id="1:10">
            <TextStylePaint fontSize="12" fontAssetId="0:400" name="S" id="1:11">
                <Fill name="F" id="1:12"><SolidColor colorValue="FFB9D4EE" name="C" id="1:13"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="1:11" text="key" name="Run" id="1:14">
                <DataBindContext sourcePathIds="1:8000-1:8002" propertyKey="268" id="1:15"/>
            </TextValueRun>
        </Text>
        <Text x="160" y="1" sizingValue="autoWidth" originX="1" name="Value" id="1:20">
