    <Artboard isComponent="true" defaultStateMachineId="2:31" viewModelId="0:320" viewModelInstanceId="0:330"
              x="1900" y="400" width="120" height="168" styleId="2:149" name="Plate" id="2:30">
        <LayoutComponentStyle name="Style" id="2:149"/>
        <!-- The fallback edge: the CRT's rim replaces this wherever there is
             a GPU canvas, and this is what a headless or no-GPU run draws. It
             follows `plate`, so it is hidden on the ink-only instance — the
             ink atlas holds the RANK and nothing else, and the glow the CRT
             feathers out of it would otherwise trace the card's outline. -->
        <!-- The border is INK: not bound to `plate`, so it prints over the
             tank and is designed here (strokes, feathers, gradients), while
             the CRT's rim (tuner: cardRim / cardRimWidth / cardRimMode) is the
             shader's own bevel on the outline. Set cardRim to 0 for markup only. -->
        <Shape x="60" y="84" name="Inner Border" id="2:150">
            <Rectangle width="114" height="162" originX="0.5" originY="0.5" cornerRadiusTL="8" name="P" id="2:151"/>
            <Stroke thickness="1.5" name="Edge" id="2:152"><SolidColor colorValue="FF070714" name="C" id="2:153"/></Stroke>
        </Shape>
        <!-- Ethan's trim, from the editor: a 7px stroke ON the outline, clipped
             to the Face, so what shows is the 3.5px band just inside the edge.
             This grey is the no-GPU fallback. With a GPU canvas the CRT's rim
             is drawn over exactly this band (same signed distance, tuner:
             cardRimWidth 3.5) in the `chrome` material — brushed metal that
             mirrors the water, so it catches the scene's glints and hues. It
             follows `plate` like the Face, so a tank card's ink instance has
             no trim: the shader draws that card's rim over the tank itself. -->
        <Shape x="60" y="84" name="trim" id="2:1450">
            <Rectangle width="120" height="168" originX="0.5" originY="0.5" cornerRadiusTL="10" name="P" id="2:1451"/>
            <Stroke thickness="7" name="Stroke 1" id="2:1452"><SolidColor colorValue="FF6E6E6E" name="C" id="2:1453"/></Stroke>
            <ClippingShape sourceId="2:154" name="Face" id="2:1454"/>
            <DataBindContext sourcePathIds="0:320-0:327" propertyKey="18" id="2:1455"/>
        </Shape>
        <Shape x="60" y="84" name="Face" id="2:154">
            <!-- `plate` is 1 on a card, 0 on the ink-only instance the table draws
                 into the ink atlas for a tank card (crt.wgsl lays it over the tank). -->
            <DataBindContext sourcePathIds="0:320-0:327" propertyKey="18" id="2:1130"/>
            <Rectangle width="120" height="168" originX="0.5" originY="0.5" cornerRadiusTL="10" name="P" id="2:155"/>
            <Fill name="Fill" id="2:156">
                <LinearGradient startX="-60" startY="-84" endX="60" endY="84" name="G" id="2:157">
                    <GradientStop colorValue="FFFFFFFF" position="0" id="2:158"/>
                    <GradientStop colorValue="FFF4F7FA" position="1" id="2:159"/>
                </LinearGradient>
            </Fill>
        </Shape>
        <StateMachine name="State Machine 1" id="2:31">
            <StateMachineLayer name="Layer 1" id="2:160"><AnyState x="300" y="0" id="2:161"/><ExitState x="400" y="0" id="2:162"/><EntryState x="0" y="0" id="2:163"/></StateMachineLayer>
        </StateMachine>
    </Artboard>

