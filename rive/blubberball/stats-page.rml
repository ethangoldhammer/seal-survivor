        <Text x="600" y="178" width="250" height="30" sizingValue="fixed" overflowValue="fitFontSize" wrapValue="noWrap" alignValue="center" verticalAlignValue="middle" originX="0.5" originY="0.5" name="Right Name" id="2:50">
