        </Text>
        <!-- ===================================================================
             THE WINNER'S STAMP — the one thing on this page that says who won.
             It sits beside the winning column, level with that side's score:
             the name is above it and the big number beside it, so the badge
             reads as a mark ON that column rather than a line about the match.

             ONE NODE, A BOUND x. `winnerX` is the column's own x (190 or 710,
             written by ui/statsCard.js), so there is one stamp, one wave and
             one place the wording lives. A second copy per side would be a
             second of each. `hasWinner` is what shows it, and a DRAW sets
             neither — the absence of the stamp is how a level match reads now.

             THE TILT is the stamp. It is small, it is off-axis, and it is the
             difference between a badge and another label.
             =================================================================== -->
        <Node x="190" y="222" rotation="-0.15" opacity="0" name="Winner Stamp" id="2:470">
            <DataBindContext sourcePathIds="3:30-3:241" propertyKey="13" id="0:5423"/>

            <Text x="0" y="0" sizingValue="autoWidth" originX="0.5" originY="0.5" name="Winner Label" id="2:471">
                <TextStylePaint letterSpacing="0.18" fontAssetId="3:1" name="S" id="2:472">
                    <DataBindContext sourcePathIds="3:30-3:210-3:312" propertyKey="274" id="0:5424"/>
                    <Fill name="Fill" id="0:5425">
                        <SolidColor colorValue="FF3FE0C8" name="C" id="0:5426">
                            <DataBindContext sourcePathIds="3:30-3:49" propertyKey="37" id="0:5427"/>
                        </SolidColor>
                    </Fill>
                </TextStylePaint>
                <TextValueRun styleId="2:472" text="lorem" name="Run" id="2:473">
                    <DataBindContext sourcePathIds="3:30-3:242" propertyKey="268" id="0:5428"/>
                </TextValueRun>

                <!-- THE WAVE. A crest that travels through the characters, one
                     lifted at a time — the group says how far a fully covered
                     glyph moves, the range says which glyphs are covered, and
                     the loop below slides the range along.

                     `modifyTranslation` is not optional: `y` without it is
                     stored and never read, and the text renders perfectly
                     still with a clean build. A modifier value with no
                     matching flag is one of the failures `inspect` does not
                     report.

                     THE PEAK IS A TRIANGLE. `falloffFrom`/`falloffTo` are
                     positions rather than widths, and leaving them at their
                     defaults (0 and 1) puts both ramps at zero width, which
                     makes each glyph pop to full lift and back — a jitter, not
                     a wave. Holding them a hair apart inside the span is what
                     gives the crest its two slopes. -->
                <TextModifierGroup modifyTranslation="true" y="-7" name="Wave" id="2:474">
                    <TextModifierRange modifyFrom="0" modifyTo="0.34"
                                       falloffFrom="0.15" falloffTo="0.19" name="Crest" id="2:475"/>
                </TextModifierGroup>
            </Text>
        </Node>

        <Shape x="300" y="136" name="Left Swatch" id="0:3863">
            <Rectangle width="120" height="8" originX="0.5" originY="0.5"
                       cornerRadiusTL="4" cornerRadiusTR="0" cornerRadiusBL="0" cornerRadiusBR="0" name="Path" id="0:3864"/>
            <Fill name="Fill" id="0:3865">
                <SolidColor colorValue="FFF5B02E" name="C" id="0:3866">
                    <DataBindContext sourcePathIds="3:30-3:40" propertyKey="37" id="0:3867"/>
                </SolidColor>
            </Fill>
        </Shape>
        <Shape x="600" y="136" name="Right Swatch" id="0:3868">
            <Rectangle width="120" height="8" originX="0.5" originY="0.5"
