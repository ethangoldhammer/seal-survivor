        <!-- THE CREST, SLIDING. `offset` (key 319) shifts the whole range along
             the text, and one full unit is one whole pass — so 0 to 1 is a
             cycle whose last frame is its first, and `loop` has no seam to pop
             at. The range WRAPS at the ends by default (`clamp` is false), so
             a crest leaving the last character is already re-entering the
             first: the word ripples rather than pulsing.

             90 frames at 60fps — a pass and a half a second. -->
        <LinearAnimation loopValue="loop" fps="60" duration="90" name="Winner Wave" id="2:478">
            <KeyedObject objectId="2:475" id="0:5436">
                <KeyedProperty propertyKey="319" id="0:5437">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear" id="0:5438"/>
                    <KeyFrameDouble value="1" frame="90" interpolationType="linear" id="0:5439"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

