<Rive version="1" kind="fragment">

    <!-- =========================================================================
         DATA — the assets, the converters and the view models both artboards
         read. Root elements, never nested inside an artboard.

         NAMES ARE THE PUBLIC SURFACE. The game sets these by name, `--data`
         addresses them by name, and renaming one is a breaking change in a way
         renumbering an id is not. Ids are private.
         ========================================================================= -->

    <FontAsset file="fonts/Orbitron.ttf" name="Orbitron" id="3:1"/>

    <!-- A number bound into a text run needs a converter, and this one defaults
         to SIX decimals: without round/decimals a score reads 0.000000. -->
    <DataConverterToString round="true" decimals="0" name="Whole Number" id="3:90"/>
    <DataConverterToString round="true" decimals="0" name="Percent" id="3:93"/>
    <DataConverterBooleanNegate name="Not" id="3:91"/>

    <!-- Possession 0-100 into the bar's 620px. The track's width is hard-coded
         here because there is no way to bind against a layout-resolved size —
         change the bar and change this with it. -->
    <DataConverterRangeMapper minInput="0" maxInput="100" minOutput="0" maxOutput="620"
                              clampLower="true" clampUpper="true" name="To Bar Width" id="3:92"/>

    <!-- ---------------------------------------------------------------- seat -->
    <ViewModel defaultInstanceId="3:19" name="SeatCard" id="3:10">
        <ViewModelPropertyString  name="seatName" id="3:11"/>
        <ViewModelPropertyColor   name="teamColor" id="3:12"/>
        <ViewModelPropertyString  name="roleLabel" id="3:13"/>
        <ViewModelPropertyString  name="readyLabel" id="3:14"/>
        <!-- THE SAME Theme INSTANCE the stats page wears. Two view models, one
             instance: a seat card styled out of its own copy would drift from
             the page it sits beside the moment either was tuned. -->
        <ViewModelPropertyViewModel viewModelReferenceId="3:300" name="theme" id="3:220"/>

        <ViewModelPropertyBoolean name="hover" id="3:15"/>
        <ViewModelPropertyBoolean name="ready" id="3:16"/>

        <ViewModelInstance exports="true" name="Default" id="3:19">
            <ViewModelInstanceString  propertyValue="Lorem ipsum"    viewModelPropertyId="3:11" name="Component" id="0:3421"/>
            <ViewModelInstanceColor   propertyValue="FFF5B02E"       viewModelPropertyId="3:12" name="Component" id="0:3422"/>
            <ViewModelInstanceString  propertyValue="dolor sit amet" viewModelPropertyId="3:13" name="Component" id="0:3423"/>
            <ViewModelInstanceString  propertyValue="Lorem"          viewModelPropertyId="3:14" name="Component" id="0:3424"/>
            <ViewModelInstanceViewModel propertyValue="3:310" viewModelPropertyId="3:220" id="0:5053"/>
            <ViewModelInstanceBoolean propertyValue="false"          viewModelPropertyId="3:15" name="Component" id="0:3425"/>
            <ViewModelInstanceBoolean propertyValue="false"          viewModelPropertyId="3:16" name="Component" id="0:3426"/>
        </ViewModelInstance>
    </ViewModel>

    <!-- -------------------------------------------------------------- a seat's
         own line on the players tab. One of these per seat, held by MatchStats
         as eight nested view models, so four a side has somewhere to land. -->
    <ViewModel defaultInstanceId="3:110" name="PlayerStat" id="3:100">
        <ViewModelPropertyString name="name"    id="3:101"/>
        <ViewModelPropertyNumber name="goals"   id="3:102"/>
        <ViewModelPropertyNumber name="assists" id="3:103"/>
        <ViewModelPropertyNumber name="saves"   id="3:104"/>

        <ViewModelInstance exports="true" name="Seat 1" id="3:110">
            <ViewModelInstanceString propertyValue="Lorem ipsum" viewModelPropertyId="3:101" name="Component" id="0:3427"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="3:102" name="Component" id="0:3428"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="3:103" name="Component" id="0:3429"/>
