        </ViewModelInstance>
    </ViewModel>


    <!-- =========================================================================
         THEME — every stroke, glow, shadow, dash and type size on the page, in
         one block.

         THIS IS THE TUNING SURFACE. Change a number here and every element
         wearing it changes together; `npm run rive:watch` rebuilds on save, so
         it is a slider you edit with a keyboard. `rive rive/blubberball
         --data=theme/glowSpread=40 --screenshot=out.png` tries one without
         touching the file at all.

         WHAT IS HERE AND WHAT IS NOT, because the split is load-bearing: a
         property is either BOUND to this or KEYFRAMED by a state, never both —
         the timeline wins and the bind silently does nothing. So this holds the
         STYLE (how thick, how soft, how big, how long a dash) and the state
         machines hold the STATE (what colour right now, how far the outline has
         drawn). Hovering a button changes its colour and its trim; it does not
         change its thickness, and that is why thickness can live here.
         ========================================================================= -->
    <ViewModel defaultInstanceId="3:310" name="Theme" id="3:300">
        <!-- Strokes. `glowWidth` is the feathered copy under the crisp one —
             the feathered paint REPLACES the shape it is on, so a halo is
             always two strokes and this is the lower of the two. -->
        <ViewModelPropertyNumber name="strokeWidth" id="3:301"/>
        <ViewModelPropertyNumber name="glowWidth"   id="3:302"/>
        <ViewModelPropertyNumber name="glowSpread"  id="3:303"/>

        <!-- The drop shadow: a second feathered stroke behind the button,
             pushed down. Rive has no shadow primitive and a Feather inside a
             Fill renders nothing at all, so a soft dark edge IS the shadow. -->
        <ViewModelPropertyNumber name="shadowSpread" id="3:304"/>
        <ViewModelPropertyNumber name="shadowDrop"   id="3:305"/>

        <!-- The dashed edge. `dashOn`/`dashOff` alternate drawn and gap in path
             units; `dashDrift` slides the whole pattern along the outline. -->
        <ViewModelPropertyNumber name="dashOn"    id="3:306"/>
        <ViewModelPropertyNumber name="dashOff"   id="3:307"/>
        <!-- A STANDING offset for the edges that do NOT spin (the seat card, the
             goal card). The four buttons on the stats page keyframe their own
             offset instead and ignore this — a property is either bound or
             keyframed, never both. -->
        <ViewModelPropertyNumber name="dashDrift" id="3:308"/>
        <ViewModelPropertyNumber name="edgeStart" id="3:309"/>

        <!-- COLOURS THE STATES SHARE. A glow or a shadow now lives on a shape
             of its own, so its COLOUR can be bound here while its OPACITY is
             keyframed per state — which is the only way to have both, a
             property being either bound or keyframed and never both. Change
             the tint or the alpha here and every button follows; change how
             far it fades on hover in the state's own animation. -->
        <ViewModelPropertyColor  name="glowColor"   id="3:316"/>
        <ViewModelPropertyColor  name="shadowColor" id="3:317"/>

        <!-- Type. One number per ROLE rather than per element: every row
             heading is `bodySize`, every tally is `numberSize`. -->
        <ViewModelPropertyNumber name="titleSize"  id="3:311"/>
        <ViewModelPropertyNumber name="labelSize"  id="3:312"/>
        <ViewModelPropertyNumber name="bodySize"   id="3:313"/>
        <ViewModelPropertyNumber name="numberSize" id="3:314"/>
        <ViewModelPropertyNumber name="tracking"   id="3:315"/>

        <ViewModelInstance exports="true" name="Default" id="3:310">
            <ViewModelInstanceNumber propertyValue="2"    viewModelPropertyId="3:301" id="0:4669"/>
            <ViewModelInstanceNumber propertyValue="3"    viewModelPropertyId="3:302" id="0:4670"/>
            <ViewModelInstanceNumber propertyValue="16"   viewModelPropertyId="3:303" id="0:4671"/>
            <ViewModelInstanceNumber propertyValue="14"   viewModelPropertyId="3:304" id="0:4672"/>
            <ViewModelInstanceNumber propertyValue="7"    viewModelPropertyId="3:305" id="0:4673"/>
            <ViewModelInstanceNumber propertyValue="22"   viewModelPropertyId="3:306" id="0:4674"/>
            <ViewModelInstanceNumber propertyValue="9"    viewModelPropertyId="3:307" id="0:4675"/>
            <ViewModelInstanceNumber propertyValue="0"    viewModelPropertyId="3:308"/>
            <ViewModelInstanceNumber propertyValue="0"    viewModelPropertyId="3:309" id="0:4677"/>
            <ViewModelInstanceColor  propertyValue="FF3FE0C8" viewModelPropertyId="3:316"/>
            <ViewModelInstanceColor  propertyValue="A6000000" viewModelPropertyId="3:317"/>
            <ViewModelInstanceNumber propertyValue="21"   viewModelPropertyId="3:311" id="0:4678"/>
            <ViewModelInstanceNumber propertyValue="18"   viewModelPropertyId="3:312" id="0:4679"/>
            <ViewModelInstanceNumber propertyValue="17"   viewModelPropertyId="3:313" id="0:4680"/>
            <ViewModelInstanceNumber propertyValue="30"   viewModelPropertyId="3:314" id="0:4681"/>
            <ViewModelInstanceNumber propertyValue="0.08" viewModelPropertyId="3:315" id="0:4682"/>
        </ViewModelInstance>
    </ViewModel>


    <!-- ---------------------------------------------------------- goal card
         The card that pops after a goal: who scored, what set it up, and the
         clock it happened on. Every field is the match's — nothing here is a
         written line, so none of it is a uiText row. `line` arrives already
         composed (systems/versus.js fills {name} into the versusAssist row),
         because who assisted is a sentence the match builds and not a label
         this artboard could look up. -->
    <ViewModel defaultInstanceId="3:410" name="GoalCard" id="3:400">
        <ViewModelPropertyString name="scorerName" id="3:401"/>
        <ViewModelPropertyString name="goalLine"   id="3:402"/>
        <ViewModelPropertyString name="goalClock"  id="3:403"/>
        <ViewModelPropertyColor  name="goalColor"  id="3:404"/>
        <ViewModelPropertyViewModel viewModelReferenceId="3:300" name="theme" id="3:405"/>

        <ViewModelInstance exports="true" name="Default" id="3:410">
            <ViewModelInstanceString propertyValue="Lorem ipsum" viewModelPropertyId="3:401" id="0:5054"/>
            <ViewModelInstanceString propertyValue="dolor sit amet" viewModelPropertyId="3:402" id="0:5055"/>
            <ViewModelInstanceString propertyValue="0:00" viewModelPropertyId="3:403" id="0:5056"/>
            <ViewModelInstanceColor  propertyValue="FFF5B02E" viewModelPropertyId="3:404" id="0:5057"/>
            <ViewModelInstanceViewModel propertyValue="3:310" viewModelPropertyId="3:405" id="0:5058"/>
        </ViewModelInstance>
    </ViewModel>

    <!-- --------------------------------------------------------------- match -->
    <ViewModel defaultInstanceId="3:59" name="MatchStats" id="3:30">
        <ViewModelPropertyString  name="title"       id="3:31"/>
        <ViewModelPropertyString  name="leftName"    id="3:32"/>
        <ViewModelPropertyString  name="rightName"   id="3:33"/>
        <ViewModelPropertyNumber  name="leftScore"   id="3:34"/>
        <ViewModelPropertyNumber  name="rightScore"  id="3:35"/>

        <ViewModelPropertyNumber  name="leftGoals"    id="3:36"/>
        <ViewModelPropertyNumber  name="leftAssists"  id="3:37"/>
        <ViewModelPropertyNumber  name="leftSaves"    id="3:38"/>
        <ViewModelPropertyNumber  name="rightGoals"   id="3:42"/>
        <ViewModelPropertyNumber  name="rightAssists" id="3:43"/>
        <ViewModelPropertyNumber  name="rightSaves"   id="3:44"/>

        <!-- Share of the ball, 0-100 each. The bar draws leftPossession over a
             track in the right side's colour, so the split IS the colour. -->
        <ViewModelPropertyNumber  name="leftPossession"  id="3:57"/>
        <ViewModelPropertyNumber  name="rightPossession" id="3:58"/>

        <ViewModelPropertyColor   name="leftColor"  id="3:40"/>
        <ViewModelPropertyColor   name="rightColor" id="3:41"/>
        <ViewModelPropertyColor   name="accent"     id="3:49"/>

        <ViewModelPropertyString  name="goalsLabel"      id="3:45"/>
        <ViewModelPropertyString  name="assistsLabel"    id="3:46"/>
        <ViewModelPropertyString  name="savesLabel"      id="3:47"/>
        <ViewModelPropertyString  name="possessionLabel" id="3:56"/>
        <ViewModelPropertyString  name="versusLabel"     id="3:48"/>

        <!-- Optional: no badge at all unless the match set one. -->
        <ViewModelPropertyBoolean name="isRecord"    id="3:60"/>
        <ViewModelPropertyString  name="recordLabel" id="3:61"/>

        <!-- THE CHAMPION, folded onto this page. It was a DOM text box floating
             over the artboard at the end of a match (.sv-versus-card-win in
             systems/versus.js) — the result was the one thing on screen that
             was not part of the page announcing it.

             THE NAME COMES WITH THE LABEL. Who won is the side, not the seal
             that scored the last goal, and the two runs are one line: the label
             small and tracked, the name after it. The goal card still names the
             SEAL, because that is what a goal is.

             `hasChampion` is what shows it, and it SHARES THE BADGE BAND with
             the record pill above — both sit under the title and neither is
             laid out around the other, so the page must never be handed both.
             ui/statsCard.js is where that is enforced; there is nothing in the
             artboard that can stop it. A draw has no champion and sets none of
             these, which is the same blank the DOM box had. -->
        <ViewModelPropertyBoolean name="hasChampion"   id="3:232"/>
        <ViewModelPropertyString  name="championLabel" id="3:230"/>
        <ViewModelPropertyString  name="championName"  id="3:231"/>

        <ViewModelPropertyString  name="tabTeamLabel"    id="3:62"/>
        <ViewModelPropertyString  name="tabPlayersLabel" id="3:63"/>
        <ViewModelPropertyBoolean name="showPlayers"     id="3:64"/>

        <!-- How many seats this match was played with. A row past it is drawn
             at zero opacity: a one-a-side match must not show six empty seats. -->
        <ViewModelPropertyNumber  name="seatsPerSide" id="3:69"/>

        <!-- THE PLAY-AGAIN PROMPT, folded into this page. It used to be a DOM
             panel under the card, which the card covered.

             `overCursor` is the ONE selection: a pad, a key and the pointer all
             move the same number, so hover and D-pad cannot disagree about
             which button is lit. `overPick` is the answer coming back — a
             NUMBER rather than a trigger, because a number can be read by
             `--data-dump` and therefore tested headlessly, and because the
             match already polls this prompt every frame for the pads. -->
        <ViewModelPropertyViewModel viewModelReferenceId="3:300" name="theme" id="3:210"/>

        <ViewModelPropertyString  name="overTitle"    id="3:200"/>
        <ViewModelPropertyString  name="rematchLabel" id="3:201"/>
        <ViewModelPropertyString  name="menuLabel"    id="3:202"/>
        <ViewModelPropertyNumber  name="overCursor"   id="3:203"/>
        <ViewModelPropertyBoolean name="overShown"    id="3:204"/>
        <ViewModelPropertyNumber  name="overPick"     id="3:205"/>

