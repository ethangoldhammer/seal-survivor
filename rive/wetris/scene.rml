<Rive version="1" kind="fragment">

    <!-- =========================================================================
         WETRIS — a falling-block stacker, played on sealitaire's water.

         A STUB in sealitaire's shape: one fill-sized artboard, one
         ScriptedLayout (board.luau) that owns every pixel and every input,
         the rules pure in wetris.luau and proved by tests.luau.

         The water under it is sealitaire's: vortex / goo / foam / surface are
         symlinks into rive/sealitaire, found by the build's directory scan
         like any shader. crt.wgsl is wetris's own compositor with
         sealitaire's screen treatment. See board.luau's header.

         Hierarchy order: FIRST child draws on TOP.
         ========================================================================= -->

    <Artboard defaultStateMachineId="0:4" viewModelId="0:300" viewModelInstanceId="0:310"
              clip="true" x="0" y="0" width="1600" height="1000" styleId="0:3"
              name="Wetris" id="0:2">
        <Fill name="Background" id="0:6">
            <SolidColor colorValue="FF07182B" name="Color" id="0:7"/>
        </Fill>
        <LayoutComponentStyle name="Artboard Style" id="0:3"/>

        <LayoutComponent width="1600" height="1000" styleId="0:11" name="Root" id="0:10">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="Root Style" id="0:11"/>
            <ScriptedLayout scriptAssetId="0:401" name="Board" id="0:12">
                <ScriptInputArtboard artboardId="0:500" name="hud" id="0:14"/>
                <ScriptInputArtboard artboardId="1:7000" name="tunerRow" id="0:18"/>
                <ScriptInputArtboard artboardId="1:7100" name="tunerHead" id="0:19"/>
                <FocusData id="0:15"/>
            </ScriptedLayout>
            <!-- The editor's, added on its first open; kept so a pull stops
                 reporting it. -->
            <ComponentOrigin id="1:9105"/>
        </LayoutComponent>

        <StateMachine name="State Machine 1" id="0:4">
            <StateMachineLayer name="Layer 1" id="0:5">
                <AnyState x="300" y="0" id="0:8"/>
                <ExitState x="400" y="0" id="0:9"/>
                <EntryState x="0" y="0" id="0:16"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- =========================================================================
         THE READOUT — the score, the level in its ring, the lines, bound to
         the Board view model; an artboard of its own so board.luau can
         instance it into the scene canvas (through the CRT with everything
         else), scale it with the screen, and pop it on a clear. No word labels
         (every word a player reads is Ethan's): the level is told apart by its
         ring and its gold, the lines by the bar board.luau draws under the
         score toward the next level.
         ========================================================================= -->
    <Artboard isComponent="true" defaultStateMachineId="0:504" viewModelId="0:300" viewModelInstanceId="0:310"
              x="0" y="1100" width="340" height="110" styleId="0:501" name="Readout" id="0:500">
        <LayoutComponentStyle name="Style" id="0:501"/>
        <!-- THE SCORE, big, in the title face with a feathered glow. board.luau
             counts it up and pops the whole readout on a clear. -->
        <Text x="80" y="0" sizingValue="autoWidth" name="Score" id="0:20">
            <TextStylePaint fontSize="55" fontAssetId="1:9111" familyName="Abril Fatface" styleName="Regular" name="Big" id="0:21">
                <Stroke thickness="4" name="Glow" id="0:26"><SolidColor colorValue="FFF6F1E7" name="C" id="0:27"/><Feather strength="16" name="F" id="0:28"/></Stroke>
                <Fill name="Fill" id="0:22"><SolidColor colorValue="FFF6F1E7" name="C" id="0:23"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="0:21" text="0" name="Run" id="0:24">
                <DataBindContext sourcePathIds="0:300-0:301" propertyKey="268" id="0:25"/>
            </TextValueRun>
        </Text>
        <!-- Total lines, small, after the level bar board.luau draws under the score. -->
        <Text x="244" y="78" sizingValue="autoWidth" name="Lines" hidden="true" id="0:30">
            <TextStylePaint fontSize="20" letterSpacing="0.06" fontAssetId="1:9111" familyName="Abril Fatface" styleName="Regular" name="Small" id="0:31">
                <Stroke thickness="1.5" name="Glow" id="0:36"><SolidColor colorValue="FF7FB6E8" name="C" id="0:37"/><Feather strength="5" name="F" id="0:38"/></Stroke>
                <Fill name="Fill" id="0:32"><SolidColor colorValue="FFB9DCF6" name="C" id="0:33"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="0:31" text="Lines " name="Run" id="0:34"/>
            <TextValueRun styleId="0:31" text="0" name="Run 2" id="1:9118">
                <DataBindContext sourcePathIds="0:300-0:302" propertyKey="268" id="1:9119"/>
            </TextValueRun>
        </Text>
        <!-- THE LEVEL, a number in a ring — grouped in the editor so the pair
             scales and moves as one. -->
        <Node x="36" y="37" scaleX="0.83999997" scaleY="0.83999997" id="1:9110">
            <Text x="0" y="0" sizingValue="autoWidth" originX="0.5" originY="0.5" name="Level" id="0:40">
                <TextStylePaint fontSize="52" fontAssetId="1:9111" familyName="Abril Fatface" styleName="Regular" name="Mid" id="0:41">
                    <Stroke thickness="2.5" name="Glow" id="0:46"><SolidColor colorValue="FFFFE296" name="C" id="0:47"/><Feather strength="10" name="F" id="0:48"/></Stroke>
                    <Fill name="Fill" id="0:42"><SolidColor colorValue="FF66C0F7" name="C" id="0:43"/></Fill>
                </TextStylePaint>
                <TextValueRun styleId="0:41" text="1" name="Run" id="0:44">
                    <DataBindContext sourcePathIds="0:300-0:303" propertyKey="268" id="0:45"/>
                </TextValueRun>
            </Text>
            <Shape x="0" y="0" name="Level Ring" id="0:50">
                <Ellipse width="64" height="64" originX="0.5" originY="0.5" name="P" id="0:51"/>
                <Stroke thickness="1" name="Ring" id="0:52"><SolidColor colorValue="CCFFFFFF" name="C" id="0:53"/><Feather strength="0" name="F" id="0:54"/></Stroke>
                <Fill name="Fill" id="0:55"><SolidColor colorValue="0DFFFFFF" name="C" id="0:56"/></Fill>
            </Shape>
        </Node>

        <StateMachine name="State Machine 1" id="0:504">
            <StateMachineLayer name="Layer 1" id="0:505">
                <AnyState x="300" y="0" id="0:506"/>
                <ExitState x="400" y="0" id="0:507"/>
                <EntryState x="0" y="0" id="0:508"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>
    <ComponentAsset artboardId="0:500" name="Readout" id="0:509"/>

    <ViewModel defaultInstanceId="0:310" name="Board" id="0:300">
        <ViewModelPropertyString name="score" id="0:301"/>
        <ViewModelPropertyString name="lines" id="0:302"/>
        <ViewModelPropertyString name="level" id="0:303"/>
        <!-- The lab, sealitaire's trick: `rive rive/wetris --data=lab=clear`
             stages a board for a screenshot (board.luau, stageLab). Blank in
             play. -->
        <ViewModelPropertyString name="lab" id="0:305"/>
        <ViewModelInstance exports="true" name="Instance" id="0:310">
            <ViewModelInstanceString propertyValue="1298479218" viewModelPropertyId="0:301" id="0:311"/>
            <ViewModelInstanceString propertyValue="0" viewModelPropertyId="0:302" id="0:312"/>
            <ViewModelInstanceString propertyValue="6" viewModelPropertyId="0:303" id="0:313"/>
            <ViewModelInstanceString propertyValue="" viewModelPropertyId="0:305" id="0:315"/>
        </ViewModelInstance>
    </ViewModel>

    <!-- Inter is 0:400 because tuner.rml (sealitaire's, shared byte for byte)
         names its font by that id. -->
    <FontAsset file="fonts/Inter.ttf" name="Inter" id="0:400"/>
    <FontAsset file="fonts/Abril Fatface.ttf" name="Abril Fatface" id="0:420"/>
    <!-- Ethan's, from the editor (2026-09-25): Water Brush is the readout's
         face now; Pixelify Sans came in with it and is not used yet. -->
    <FontAsset file="fonts/Water Brush.ttf" isCustom="false" assetId="4230788" name="Water Brush" id="1:9111"/>
    <FontAsset file="fonts/Pixelify Sans.ttf" isCustom="false" assetId="4229865" name="Pixelify Sans" id="1:9106"/>
    <!-- The seal's baked rig and clips (sealitaire's, test:wetrisshared). A
         blob DOES need this line, whatever sealitaire's asset comment says:
         without it the build leaves the file out and context:blob('seal') is
         nil. Shaders are the ones the directory scan finds on its own. -->
    <BlobAsset file="seal.mesh" name="seal" id="0:410"/>
    <!-- Which take plays for which event (sound.luau; tools/wetris-sfx.mjs gathers the files). -->
    <BlobAsset file="sfxEvents.csv" name="sfxEvents" id="0:416"/>
    <!-- THE MUSIC: the loop (tools/wetris-music.mjs encodes it from the lossless
         bounce) and its exact length, which music.luau schedules repeats by. -->
    <AudioAsset file="music/wetris.mp3" name="wetrisLoop" id="0:430"/>
    <BlobAsset file="musicLoop.csv" name="musicLoop" id="0:431"/>

    <ScriptAsset file="wetris.luau" isModule="true" name="wetris" id="0:402"/>
    <ScriptAsset file="puddle.luau" isModule="true" name="puddle" id="0:404"/>
    <ScriptAsset file="ink.luau" isModule="true" name="ink" id="0:413"/>
    <ScriptAsset file="knock.luau" isModule="true" name="knock" id="0:417"/>
    <ScriptAsset file="drips.luau" isModule="true" name="drips" id="0:414"/>
    <ScriptAsset file="tiles.luau" isModule="true" name="tiles" id="0:415"/>
    <!-- The seal: react, motion and puppet before swimmer, which requires them.
         puppet and react are sealitaire's (test:wetrisshared); motion is ours. -->
    <ScriptAsset file="tuning.luau" isModule="true" name="tuning" id="0:411"/>
    <ScriptAsset file="tuner.luau" isModule="true" name="tuner" id="0:412"/>
    <ScriptAsset file="sound.luau" isModule="true" name="sound" id="0:418"/>
    <ScriptAsset file="music.luau" isModule="true" name="music" id="0:419"/>
    <ScriptAsset file="react.luau" isModule="true" name="react" id="0:406"/>
